# systemd-Dienst für Trinkimal (PocketBase). Wird von server/install.sh eingerichtet.
# Adresse oder Domain stehen in /opt/trinkimal/trinkimal.env, nicht hier.

[Unit]
Description=Trinkimal (PocketBase)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=trinkimal
Group=trinkimal
WorkingDirectory=/opt/trinkimal
EnvironmentFile=/opt/trinkimal/trinkimal.env
ExecStart=/opt/trinkimal/pocketbase serve $TRINKIMAL_ARGS --dir=/opt/trinkimal/pb_data --publicDir=/opt/trinkimal/pb_public --hooksDir=/opt/trinkimal/pb_hooks --migrationsDir=/opt/trinkimal/pb_migrations
Restart=always
RestartSec=5s
LimitNOFILE=4096
# Erlaubt Port 80/443 ohne root, falls eine Domain eingetragen ist
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
